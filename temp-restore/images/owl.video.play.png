<div id="ocp-notification" class="ocp-bubble">
    Need guidance? Your PU coach is here! âš¡
</div>

<div id="ocp_widget" style="
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 1000;
"></div>
<script async="" defer="" src="../js/float.js"></script>
<script>
    let widgetMinimized = true;
    const notification = document.getElementById('ocp-notification');

    function updateNotification() {
        notification.style.display = widgetMinimized ? 'block' : 'none';
    }

    document.addEventListener('click', function (e) {
        if (e.clientX > window.innerWidth - 100 &&
            e.clientY > window.innerHeight - 100) {
            widgetMinimized = !widgetMinimized;
            updateNotification();
        }
    });

    updateNotification();
</script>



