<style id="wp-custom-css">
.postid-6177 [data-bs-target="#pathway-program"], .postid-6177 #pathway-program{
    display: none;
}

.information-cards-v2{
	width:100%;
}


.ipi-tabs {
	border: none;
	gap: 12px;
	margin-bottom: 30px !important;
}

.ipi-tabs .nav-link {
	min-width: 260px;
	border-radius: 14px;
	padding: 14px 30px;
	border: 2px solid #D8D6E8;
	background: #fff;
	color: #333;
	font-size: 18px;
	font-weight: 600;
	transition: all .35s ease;
}

.ipi-tabs .nav-link:hover {
	border-color: #5242D8;
	color: #5242D8;
}

.ipi-tabs .nav-link.active {
	background: linear-gradient(90deg,
			#5242D8,
			#A74571);
	border-color: transparent;
	color: #fff;
	box-shadow: 0 10px 20px rgba(82, 66, 216, .15);
}

/* =====================================
   MAIN CARDS
===================================== */

.ipi-card {
	background: #fff;
	border-radius: 22px;

	border: 2px solid #D7D4E7;

	box-shadow:
		0 0 0 1px rgba(255, 255, 255, .8) inset,
		0 4px 12px rgba(0, 0, 0, .03);

	padding: 28px;
	height: 100%;

	transition: all .35s ease;
}

.ipi-card:hover {
	transform: translateY(-6px);

	border-color: #C8C3E8;

	box-shadow:
		0 20px 40px rgba(82, 66, 216, .10);
}

/* =====================================
   ICON BOX
===================================== */

.ipi-icon-box {
	width: 72px;
	height: 72px;

	border-radius: 18px;

	background: #F4F1FF;

	display: flex;
	align-items: center;
	justify-content: center;

	color: #6C52F6;
	font-size: 32px;

	margin-bottom: 20px;
}

.ipi-icon-box i {
	line-height: 1;
}

/* =====================================
   CARD CONTENT
===================================== */

.ipi-card h4 {
	font-size: 26px;
	font-weight: 700;
	color: #111;
	margin-bottom: 15px;
}

.ipi-card p {
	font-size: 16px;
	line-height: 1.8;
	color: #666;
	margin-bottom: 25px;
	min-height: 95px;
}

/* =====================================
   DOWNLOAD BUTTON
===================================== */

.ipi-download-btn {
	position: relative;
	overflow: hidden;

	height: 58px;

	display: flex;
	align-items: center;
	justify-content: space-between;

	padding: 0 18px;

	border-radius: 14px;
	border: 2px solid #8C6FF5;

	text-decoration: none;
	color: #5F46DB;

	font-size: 17px;
	font-weight: 600;

	transition: all .35s ease;
	z-index: 1;
}

.ipi-download-btn::before {
	content: "";

	position: absolute;

	top: 0;
	left: -100%;

	width: 100%;
	height: 100%;

	background: linear-gradient(90deg,
			#5242D8 21.49%,
			#A74571 91.28%);

	transition: .45s ease;
	z-index: -1;
}

.ipi-download-btn:hover::before {
	left: 0;
}

.ipi-download-btn:hover {
	color: #fff;
	border-color: transparent;
}

/* =====================================
   BUTTON ICON
===================================== */

.ipi-download-icon {
	width: 40px;
	height: 40px;

	border-radius: 50%;

	display: flex;
	align-items: center;
	justify-content: center;

	background: linear-gradient(90deg,
			#5242D8,
			#A74571);

	color: #fff;

	transition: .35s ease;
}

.ipi-download-btn:hover .ipi-download-icon {
	background: #fff;
	color: #5242D8;
}

.ipi-faculty-card {
	margin-top: 25px;
	background: #fff;
	border-radius: 22px;
	border: 2px solid #D7D4E7;
	box-shadow:
		0 0 0 1px rgba(255, 255, 255, .8) inset,
		0 4px 12px rgba(0, 0, 0, .03);

	padding: 28px;
	transition: all .35s ease;
}

.ipi-faculty-card:hover {
	transform: translateY(-6px);

	border-color: #C8C3E8;

	box-shadow:
		0 20px 40px rgba(82, 66, 216, .10);
}

.ipi-faculty-card h4 {
	font-size: 26px;
	font-weight: 700;
	margin-bottom: 10px;
}

.ipi-faculty-card p {
	color: #666;
	line-height: 1.7;
}

/* =====================================
   FACULTY BUTTON
===================================== */

.ipi-faculty-btn {
	position: relative;
	overflow: hidden;

	display: inline-flex;
	align-items: center;
	gap: 10px;

	padding: 14px 28px;

	border-radius: 14px;
	border: 2px solid #8C6FF5;

	color: #5F46DB;
	text-decoration: none;
	font-weight: 600;

	transition: .35s ease;
	z-index: 1;
}

.ipi-faculty-btn::before {
	content: "";

	position: absolute;
	left: -100%;
	top: 0;

	width: 100%;
	height: 100%;

	background: linear-gradient(90deg,
			#5242D8 21.49%,
			#A74571 91.28%);

	transition: .45s ease;
	z-index: -1;
}

.ipi-faculty-btn:hover::before {
	left: 0;
}

.ipi-faculty-btn:hover {
	color: #fff;
	border-color: transparent;
}

/* =====================================
   RESPONSIVE
===================================== */

@media(max-width:1199px) {

	.ipi-title {
		font-size: 48px;
	}

}

@media(max-width:991px) {

	.ipi-section {
		min-height: auto;
		padding: 50px 0;
	}

	.ipi-title {
		font-size: 42px;
	}

	.ipi-tabs .nav-link {
		min-width: auto;
		width: 100%;
	}

	.ipi-card p {
		min-height: auto;
	}

}

@media(max-width:767px) {

	.ipi-title {
		font-size: 34px;
	}

	.ipi-card,
	.ipi-faculty-card {
		padding: 22px;
	}

	.ipi-faculty-btn {
		width: 100%;
		justify-content: center;
	}

}
</style>
</head>

