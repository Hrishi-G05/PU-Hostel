</div>
<div class="cf7-row">
  <span class="cf7-label">Details for Above 6 Points</span>
  <span class="wpcf7-form-control-wrap" data-name="sanctioned-details"><textarea cols="40" rows="10" maxlength="2000" class="wpcf7-form-control wpcf7-textarea cf7-input" aria-invalid="false" name="sanctioned-details"></textarea></span>
</div>
<div class="cf7-row">
  <span class="cf7-label">Declaration*</span>
  <span class="wpcf7-form-control-wrap" data-name="declaration"><span class="wpcf7-form-control wpcf7-checkbox wpcf7-validates-as-required cf7-checkbox"><span class="wpcf7-list-item first last"><label><input type="checkbox" name="declaration[]" value="I certify that the above information is true."><span class="wpcf7-list-item-label">I certify that the above information is true.</span></label></span></span></span>
</div>
<div class="cf7-row">
  <input class="wpcf7-form-control wpcf7-submit has-spinner cf7-submit" type="submit" value="Submit Application">
</div><div class="wpcf7-response-output" aria-hidden="true"></div>
</form>
</div>
  </div>
</div>
</footer>

